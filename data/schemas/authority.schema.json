{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunwai-saathi.org/schemas/authority.schema.json",
  "title": "SunwaiSaathi Public Authority Directory Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "jurisdiction",
    "name",
    "status",
    "reviewedAt",
    "staleAfter",
    "pioOffice",
    "faaOffice",
    "filingRoutes",
    "sourceIds",
    "review"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "jurisdiction": { "enum": ["central", "delhi", "haryana", "maharashtra", "goa"] },
    "name": { "type": "string", "minLength": 1 },
    "parentAuthorityId": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["research", "technical-reviewed", "filing-ready", "stale", "unsupported", "disabled"] },
    "reviewedAt": { "type": ["string", "null"], "format": "date" },
    "staleAfter": { "type": ["string", "null"], "format": "date" },
    "pioOffice": { "$ref": "#/$defs/office" },
    "faaOffice": { "$ref": "#/$defs/office" },
    "filingRoutes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["online", "post", "in-person"] }
    },
    "portalAuthorityLabel": { "type": ["string", "null"] },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$" }
    },
    "notes": { "type": ["string", "null"] },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical", "legalRti"],
      "properties": {
        "technical": { "$ref": "source.schema.json#/$defs/reviewDecision" },
        "legalRti": { "$ref": "source.schema.json#/$defs/reviewDecision" }
      }
    }
  },
  "$defs": {
    "office": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designation", "address"],
      "properties": {
        "designation": { "type": "string", "minLength": 1 },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lines", "district", "state", "postalCode"],
          "properties": {
            "lines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "district": { "type": "string", "minLength": 1 },
            "state": { "type": "string", "minLength": 1 },
            "postalCode": { "type": "string", "pattern": "^[1-9][0-9]{5}$" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "filing-ready" } }, "required": ["status"] },
      "then": {
        "properties": {
          "reviewedAt": { "type": "string", "format": "date" },
          "staleAfter": { "type": "string", "format": "date" },
          "review": {
            "properties": {
              "technical": { "properties": { "status": { "const": "approved" } } },
              "legalRti": { "properties": { "status": { "const": "approved" } } }
            }
          }
        }
      }
    }
  ]
}
